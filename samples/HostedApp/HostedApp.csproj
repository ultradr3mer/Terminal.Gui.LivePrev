<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- An app outside this repo uses <PackageReference Include="TuiPreview.Host" /> instead. -->
    <ProjectReference Include="..\..\host\TuiPreview.Host.csproj" />
  </ItemGroup>

  <!-- A package imports this itself; a ProjectReference never imports build assets. -->
  <Import Project="..\..\host\buildTransitive\TuiPreview.Host.targets" />

</Project>

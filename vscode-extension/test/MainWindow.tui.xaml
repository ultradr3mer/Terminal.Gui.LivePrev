<Window x:Class="CoreBridge.Tui.MainWindow"
        xmlns="http://schemas.gui-cs.github.io/tui/2026/xaml"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        x:DataType="ViewModel"
        Title="CoreBridge"
        Width="Dim.Fill()" 
        Height="Dim.Fill()">

  <!-- Source, not DataSource/ItemsSource: DropDownList is an IListDataSource control.
       {Bind X}, not {Binding X}: that is the only binding form the generator recognises.
       x:DataType="ViewModel" above tells it where {Bind ...} paths resolve from. -->
  <DropDownList x:Name="CommandListBox"
                X="1"
                Y="2"
                Width="24"
                Source="{Bind CommandList}"
                ValueChanged="OnCommandSelected" />

  <Label X="2"
         Y="3"
         Text="Your name:" />

  <TextField x:Name="NameField"
             X="16"
             Y="3"
             Width="24"
             TextChanged="OnNameChanged" />

  <!-- OneWay is deliberate: DropDownList has no TwoWayBindings entry, so Mode=TwoWay here
       would be rejected with TUI006. The selection is pushed to the ViewModel by
       OnCommandSelected instead, and flows back out through PropertyChanged. -->
  <Label x:Name="GreetingLabel"
         X="2"
         Y="5"
         Text="{Bind Greeting}" />

  <Button X="2"
          Y="7"
          Text="Greet"
          Accepting="OnGreetClicked" />

  <Button X="Pos.Right(Root) - 10"
          Y="Pos.Bottom(Root) - 3"
          Text="Exit"
          Accepting="OnExitClicked" />

</Window>

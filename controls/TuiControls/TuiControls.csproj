<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>TuiControls</PackageId>
    <Version>0.1.0</Version>
    <Description>Controls for Terminal.Gui that a .tui.cs view may use and the live preview can render.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Upper bound: Terminal.Gui 2.x breaks binary compatibility between minor versions, and
         these controls are compiled against this one. -->
    <PackageReference Include="Terminal.Gui" Version="[2.5.0,2.6)" />
  </ItemGroup>

</Project>

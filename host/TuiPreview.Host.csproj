<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>TuiPreview.Host</PackageId>
    <Version>0.1.0</Version>
    <Description>Live preview for Terminal.Gui views, hosted inside your own app. Call TuiPreviewHost.TryRun(args, out int code) first thing in Main.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <!-- Upper bound: Terminal.Gui 2.x breaks binary compatibility between minor versions, and the
         chrome is compiled against this one. -->
    <PackageReference Include="Terminal.Gui" Version="[2.5.0,2.6)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Previews compile to an in-memory assembly named TuiPreview; this lets the chrome be
         previewed from source against the host's internal types. -->
    <InternalsVisibleTo Include="TuiPreview" />
    <InternalsVisibleTo Include="cli" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\TuiPreview.Host.targets" Pack="true" PackagePath="build\;buildTransitive\" />
  </ItemGroup>

</Project>
